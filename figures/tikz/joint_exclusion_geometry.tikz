% Editable TikZ; fixed 3.5 in x 2 in canvas, as in the original.
% Requires the existing figures/tikz/common.tex styles and colors.
% Illustrative geometry: the two alternatives have the same excess sum, 1.40.
\begingroup%
\begin{tikzpicture}[x=1in,y=1in]%
\path[use as bounding box] (0,0) rectangle (3.5,2);%
\begin{pgfinterruptboundingbox}%
% State explicitly what the aggregate reports reveal.
\node[font=\jscfont{7.5},text=jscNavy,anchor=center,inner sep=0pt]%
  at (1.75,1.927) {Aggregate evidence: $1.05\le\theta_1+\theta_2\le1.75$};%
\begin{axis}[jsc axis,at={(0.51in,0.69in)},anchor=south west,%
width=2.87in,height=1.075in,%
xmin=-1.3,xmax=2.4,ymin=-1.3,ymax=2.4,%
xtick={-1,0,1,2},ytick={-1,0,1,2},%
xlabel={Radio-stage excess $\theta_1$},ylabel={Server-stage excess $\theta_2$},%
label style={font=\jscfont{7.5}},%
]%
% A competitor is feasible only if both excesses are nonpositive.
\path[draw=none,fill=jscPale]%
  (axis cs:-1.3,-1.3)--(axis cs:0,-1.3)--(axis cs:0,0)--(axis cs:-1.3,0)--cycle;%
% Aggregate confidence band: the sum is known, its stage split is not.
\path[draw=none,fill=jscBand]%
  (axis cs:-1.3,2.35)--(axis cs:-1.3,2.4)--(axis cs:-.65,2.4)%
  --(axis cs:2.4,-.65)--(axis cs:2.4,-1.3)--(axis cs:2.35,-1.3)--cycle;%
\addplot[jscTeal,line width=.9pt,domain=-1.3:2.4,samples=2] {1.05-x};%
\addplot[jscTeal,line width=.9pt,domain=-1.3:2.4,samples=2] {1.75-x};%
\draw[jscGrey,line width=.7pt] (axis cs:-1.3,0)--(axis cs:2.4,0);%
\draw[jscGrey,line width=.7pt] (axis cs:0,-1.3)--(axis cs:0,2.4);%
\node[font=\jscfont{7},text=jscNavy,align=center,inner sep=0pt]%
  at (axis cs:-.66,-.63) {Both stages feasible\\$\theta_1\le0,\ \theta_2\le0$};%
% Label each alternative directly; both marked points have sum 1.40.
\addplot[only marks,mark=*,mark size=2.25pt,jscServer]%
  coordinates {(-.55,1.95)};%
\addplot[only marks,mark=*,mark size=2.25pt,jscRadio]%
  coordinates {(1.95,-.55)};%
\node[font=\jscfont{7},text=jscServer,align=center,inner sep=1pt]%
  (server-case) at (axis cs:-.70,.87) {Only server\\violates limit};%
\draw[jscServer,line width=.55pt]%
  (server-case.north)--(axis cs:-.55,1.78);%
\node[font=\jscfont{7},text=jscRadio,align=center,inner sep=1pt]%
  (radio-case) at (axis cs:1.84,.87) {Only radio\\violates limit};%
\draw[jscRadio,line width=.55pt]%
  (radio-case.south)--(axis cs:1.95,-.39);%
\node[font=\jscfont{7.3},text=jscTeal,align=center,inner sep=1pt]%
  (band-label) at (axis cs:1.10,1.98) {Confidence band};%
\draw[jscTeal,line width=.55pt,-{Stealth[length=2.5pt,width=2.2pt]}]%
  (band-label.south west)--(axis cs:.50,.90);%
\end{axis}%
% The interpretation states both the certificate and its diagnostic limit.
\node[font=\jscfont{7},text=jscNavy,anchor=center,align=center,inner sep=0pt]%
  at (1.75,0.151) {Band misses feasible region: competitor excluded.\\%
  Both points have sum $1.40$: the violated stage is unknown.};%
\end{pgfinterruptboundingbox}%
\end{tikzpicture}%
\endgroup%
