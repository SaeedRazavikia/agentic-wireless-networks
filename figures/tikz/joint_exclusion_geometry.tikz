% Editable TikZ; coordinates are inches unless inside an axis.
% Numerical values come from data/; see data/PROVENANCE.json.
\begingroup%
\begin{tikzpicture}[x=1in,y=1in]%
\path[use as bounding box] (0,0) rectangle (3.5,2);%
\begin{pgfinterruptboundingbox}%
\begin{axis}[jsc axis,at={(0.63in,0.636in)},anchor=south west,%
width=2.73in,height=1.255in,%
xmin=-1.3,xmax=2.4,ymin=-1.3,ymax=2.4,xtick={-1,0,1,2},ytick={-1,0,1,2},%
xlabel={Radio-stage excess},ylabel={Server-stage excess},%
]%
\path[draw=none,fill=jscPale] (axis cs:-1.3,-1.3)--(axis cs:0,-1.3)--(axis cs:0,0)--(axis cs:-1.3,0)--cycle;%
\path[draw=none,fill=jscBand] (axis cs:-1.3,2.35)--(axis cs:-1.3,2.4)--(axis cs:-.65,2.4)--(axis cs:2.4,-.65)--(axis cs:2.4,-1.3)--(axis cs:2.35,-1.3)--cycle;%
\addplot[jscTeal,line width=.9pt,domain=-1.3:2.4,samples=2] {1.05-x};%
\addplot[jscTeal,line width=.9pt,domain=-1.3:2.4,samples=2] {1.75-x};%
\draw[jscGrey,line width=.7pt] (axis cs:-1.3,0)--(axis cs:2.4,0);%
\draw[jscGrey,line width=.7pt] (axis cs:0,-1.3)--(axis cs:0,2.4);%
\addplot[only marks,mark=*,mark size=2.2pt,jscNavy] coordinates {(-.55,1.95) (1.95,-.55)};%
\node[font=\jscfont{7.3},text=jscNavy,align=center] at (axis cs:-.68,-.64) {Jointly feasible\\rival};%
\node[font=\jscfont{7.5},text=jscTeal,align=center] at (axis cs:1.44,1.80) {Retained\\confidence band};%
\end{axis}%
\node[font={\jscfont{7}},text=jscNavy,anchor=center,align=center,inner sep=0pt] at (1.855,0.09275) {Joint feasibility is excluded; the violated stage is unidentified.};%
\end{pgfinterruptboundingbox}%
\end{tikzpicture}%
\endgroup%
