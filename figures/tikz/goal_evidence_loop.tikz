% Compact native TikZ: simplified two-row layout with the original palette and icons.
% Joint service certification for agentic wireless network optimization.
% Pure TikZ: every icon, label, and connector is editable.
% Required in the parent document:
%   \usepackage{tikz}
%   \usetikzlibrary{arrows.meta,calc}
% Designed for a two-column figure; input at the same width as the original.
% Required libraries are unchanged. Coordinates are in centimetres.
\begingroup%
\definecolor{wiNavy}{HTML}{123650}%
\definecolor{wiBlue}{HTML}{237BC1}%
\definecolor{wiPaleBlue}{HTML}{F1F8FD}%
\definecolor{wiBorder}{HTML}{B5DCF2}%
\definecolor{wiCyan}{HTML}{64BCE6}%
\definecolor{wiTeal}{HTML}{087F78}%
\definecolor{wiMint}{HTML}{EAF7F2}%
\definecolor{wiViolet}{HTML}{7746B0}%
\definecolor{wiLavender}{HTML}{F8F4FC}%
\definecolor{wiRed}{HTML}{D95D77}%
\definecolor{wiAmber}{HTML}{B87708}%
\definecolor{wiCream}{HTML}{FFF6DE}%
\definecolor{wiMuted}{HTML}{86A2B6}%
\tikzset{%
  wi flow/.style={draw=wiNavy,line width=1.7pt,%
    -{Stealth[length=7pt,width=6pt]},rounded corners=9pt},%
  wi goal flow/.style={draw=wiNavy,line width=1.25pt,dash pattern=on 5pt off 4pt,%
    -{Stealth[length=7pt,width=6pt]}},%
  wi limit flow/.style={draw=wiAmber,line width=1.4pt,%
    dash pattern=on 5pt off 3pt,-{Stealth[length=7pt,width=6pt]},%
    rounded corners=8pt},%
  wi panel/.style={draw=wiBorder,fill=wiPaleBlue,line width=1.15pt,%
    rounded corners=7pt},%
  wi verify panel/.style={draw=wiViolet,fill=wiLavender,line width=1.4pt,%
    rounded corners=8pt},%
  wi inner/.style={draw=wiViolet!78,fill=white,line width=0.95pt,%
    rounded corners=5pt},%
  wi label/.style={font=\rmfamily\bfseries\fontsize{15}{17}\selectfont,%
    text=wiNavy,align=center,inner sep=0pt},%
  wi small/.style={font=\rmfamily\fontsize{12}{14}\selectfont,%
    text=wiNavy,align=center,inner sep=0pt},%
  wi tiny/.style={font=\rmfamily\fontsize{10.5}{12}\selectfont,%
    text=wiNavy,align=center,inner sep=0pt},%
  wi arrow label/.style={font=\rmfamily\bfseries\fontsize{11.5}{13}\selectfont,%
    text=wiNavy,fill=white,inner sep=2pt},%
  wi icon/.style={draw=wiNavy,line width=0.9pt,line cap=round,line join=round},%
  pics/wi radio/.style={code={%
    \path[wi icon,fill=wiPaleBlue] (0,0.50)--(-0.47,-0.74)--(0.47,-0.74)--cycle;%
    \draw[wi icon] (-0.34,-0.41)--(0.20,-0.03)--(-0.15,0.13)%
      (0.34,-0.41)--(-0.20,-0.03)--(0.15,0.13)%
      (-0.47,-0.74)--(0.34,-0.41)%
      (0.47,-0.74)--(-0.34,-0.41);%
    \begin{scope}[shift={(0,0.60)}]%
      \fill[wiBlue] (0,0) circle (0.09);%
      \foreach \r in {0.27,0.46,0.65}{%
        \draw[draw=wiBlue,line width=0.95pt,line cap=round]%
          (135:\r) arc[start angle=135,end angle=225,radius=\r];%
        \draw[draw=wiBlue,line width=0.95pt,line cap=round]%
          (45:\r) arc[start angle=45,end angle=-45,radius=\r];%
      }%
    \end{scope}%
  }},%
  pics/wi server/.style={code={%
    \foreach \y in {-0.34,0,0.34}{%
      \path[wi icon,fill=wiNavy!88,rounded corners=1.5pt]%
        (-0.47,\y-0.135) rectangle (0.47,\y+0.135);%
      \draw[draw=wiCyan,line width=1.15pt,line cap=round]%
        (-0.32,\y)--(-0.10,\y);%
      \fill[wiCyan] (0.17,\y) circle (0.039);%
      \fill[wiMint] (0.32,\y) circle (0.039);%
    }%
  }},%
  pics/wi target/.style={code={%
    \path[wi icon,fill=wiCyan!32] (0,0) circle (0.91);%
    \path[wi icon,fill=white] (0,0) circle (0.66);%
    \path[wi icon,fill=wiCyan!32] (0,0) circle (0.42);%
    \path[wi icon,fill=white] (0,0) circle (0.18);%
    \draw[draw=wiBlue,line width=3.2pt,line cap=round,%
      -{Stealth[length=10pt,width=8pt]}] (1.04,1.04)--(0.04,0.04);%
    \path[fill=wiNavy] (0.74,0.84)--(0.74,1.17)--(0.95,1.38)%
      --(0.96,1.07)--(1.27,1.08)--(1.06,0.87)--cycle;%
  }},%
  pics/wi check/.style={code={%
    \fill[wiTeal] (0,0) circle (0.22);%
    \draw[white,line width=1.4pt,line cap=round,line join=round]%
      (-0.105,-0.005)--(-0.028,-0.08)--(0.12,0.10);%
  }},%
  pics/wi database/.style={code={%
    \path[wi icon,fill=wiCyan!37] (-1.32,0.9)--(-1.32,-0.85)%
      arc[start angle=180,end angle=360,x radius=1.32,y radius=0.33]%
      --(1.32,0.9)--cycle;%
    \draw[wi icon] (-1.32,0.26)%
      arc[start angle=180,end angle=360,x radius=1.32,y radius=0.33];%
    \draw[wi icon] (-1.32,-0.32)%
      arc[start angle=180,end angle=360,x radius=1.32,y radius=0.33];%
    \path[wi icon,fill=wiPaleBlue] (0,0.9) ellipse (1.32 and 0.33);%
  }},%
  pics/wi reuse/.style={code={%
    \path[draw=white,line width=2.6pt,fill=wiTeal] (0,0) circle (0.60);%
    \draw[white,line width=1.8pt,line cap=round,%
      -{Stealth[length=5pt,width=4.5pt]}]%
      (35:0.33) arc[start angle=35,end angle=175,radius=0.33];%
    \draw[white,line width=1.8pt,line cap=round,%
      -{Stealth[length=5pt,width=4.5pt]}]%
      (215:0.33) arc[start angle=215,end angle=355,radius=0.33];%
  }},%
  pics/wi certificate/.style={code={%
    \path[draw=wiTeal,line width=1.5pt,fill=wiMint,line join=round]%
      (-0.88,-1.14)--(0.88,-1.14)--(0.88,0.83)--(0.57,1.14)%
      --(-0.88,1.14)--cycle;%
    \path[draw=wiTeal,line width=1.1pt,fill=wiTeal]%
      (0,0.85)--(0.49,0.65)--(0.46,0.13)%
      .. controls (0.41,-0.05) and (0.18,-0.19) .. (0,-0.29)%
      .. controls (-0.18,-0.19) and (-0.41,-0.05) .. (-0.46,0.13)%
      --(-0.49,0.65)--cycle;%
    \draw[white,line width=2.3pt,line cap=round,line join=round]%
      (-0.24,0.31)--(-0.07,0.14)--(0.27,0.49);%
    \foreach \y/\endx in {-0.59/0.57,-0.79/0.35,-0.99/0.47}{%
      \draw[draw=wiTeal!63,line width=1.9pt,line cap=round]%
        (-0.57,\y)--(\endx,\y);%
    }%
  }},%
}%

\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round]%
  \path[use as bounding box] (-0.140584,-0.220584) rectangle (28.290584,8.800584);%
  % Main sequence and feedback anchors.
  \coordinate (goal-out) at (4.46,6.55);%
  \coordinate (proposal-in) at (5.10,6.55);%
  \coordinate (proposal-out) at (10.75,6.55);%
  \coordinate (verify-in) at (11.90,6.55);%
  \coordinate (verify-pass) at (21.95,6.55);%
  \coordinate (certified-in) at (24.65,6.55);%
  \coordinate (verify-needs) at (17.00,5.20);%
  \coordinate (acquire-top) at (17.00,3.85);%
  \coordinate (memory-verifier) at (7.95,3.85);%
  \coordinate (memory-acquire) at (10.75,2.70);%
  \coordinate (acquire-evidence) at (11.90,2.70);%
  \coordinate (acquire-out) at (21.95,2.70);%
  \coordinate (network-in) at (23.40,2.70);%
  \coordinate (network-reports) at (26.62,2.58);%
  \coordinate (memory-reports) at (7.95,1.40);%
  \coordinate (unresolved-in) at (24.50,4.46);%
  % Four simple panels replace the detailed nested panels.
  \path[wi panel] (5.10,5.20) rectangle (10.75,7.90);%
  \path[wi verify panel] (11.90,5.20) rectangle (21.95,7.90);%
  \path[wi panel] (5.10,1.40) rectangle (10.75,3.85);%
  \path[wi panel] (11.90,1.40) rectangle (21.95,3.85);%
  % Information flow; physical reports return to shared evidence.
  \draw[wi flow] (goal-out)--(proposal-in);%
  \draw[wi flow] (proposal-out)--(verify-in);%
  \draw[wi flow] (verify-pass)--(certified-in);%
  \draw[wi goal flow] (2.76,7.80)%
    .. controls (5.05,8.66) and (9.34,8.66) .. (12.45,7.90);%
  \node[wi arrow label] at (7.55,8.49) {Goal change};%
  \draw[wi flow] (memory-verifier)--(7.95,4.55)--(13.20,4.55)--(13.20,5.20);%
  \draw[wi flow] (memory-acquire)--(acquire-evidence);%
  \draw[wi flow] (verify-needs)--(acquire-top);%
  \node[wi arrow label,anchor=west] at (17.28,4.52) {Evidence needed};%
  \draw[wi flow] (acquire-out)--(network-in);%
  \draw[wi flow] (network-reports)--(27.95,2.58)--(27.95,0.62)%
    --(7.95,0.62)--(memory-reports);%
  \node[wi arrow label] at (17.00,0.17) {Physical reports};%
  \draw[wi limit flow] (21.95,3.58)--(22.42,3.58)%
    --(23.02,4.46)--(unresolved-in);%
  \node[wi arrow label,text=wiAmber,font=\rmfamily\bfseries\fontsize{10}{12}\selectfont] at (23.37,3.96) {Limits reached};%
  % Goal: retain the target and a single requirements line.
  \pic[scale=0.68] at (2.20,6.89) {wi target};%
  \node[wi label] at (2.43,5.73) {Goal $g$\,$\cdot$\, Context $s$};%
  \node[wi small,font=\rmfamily\fontsize{11}{13}\selectfont] at (2.43,5.17) {Service limits\,$\cdot$\, Tolerance $\epsilon$};%
  % One radio--server proposal, without repeated alternatives.
  \node[wi label] at (7.925,7.49) {Proposal $x$};%
  \pic[scale=0.63] at (6.74,6.40) {wi radio};%
  \pic[scale=1.05] at (9.12,6.40) {wi server};%
  \node[wi label,font=\rmfamily\bfseries\fontsize{20}{20}\selectfont]%
    at (7.925,6.42) {$+$};%
  \node[wi label] at (6.74,5.55) {$R_i$};%
  \node[wi label] at (9.12,5.55) {$S_j$};%
  % The verifier retains its two obligations, now as compact checks.
  \node[wi label,font=\rmfamily\bfseries\fontsize{19}{21}\selectfont]%
    at (16.925,7.45) {Common verifier};%
  \path[wi inner] (12.23,5.62) rectangle (16.50,6.84);%
  \path[wi inner] (16.78,5.62) rectangle (21.62,6.84);%
  \pic[scale=0.95] at (12.82,6.23) {wi check};%
  \node[wi label,font=\rmfamily\bfseries\fontsize{13}{15}\selectfont]%
    at (14.66,6.23) {Own feasibility};%
  \draw[wi icon,draw=wiRed,line width=2pt]%
    (17.21,6.04)--(17.59,6.42) (17.21,6.42)--(17.59,6.04);%
  \node[wi label,font=\rmfamily\bfseries\fontsize{13}{15}\selectfont]%
    at (19.60,6.23) {Exclude $\epsilon$-better\\competitors};%
  % Certified and unresolved remain distinct terminal outcomes.
  \pic[scale=0.78] at (25.70,6.93) {wi certificate};%
  \node[wi label,font=\rmfamily\bfseries\fontsize{17}{19}\selectfont]%
    at (25.70,5.65) {Certified $x$};%
  \node[wi small] at (25.70,5.17) {Feasible\,$\cdot$\, $\epsilon$-optimal};%
  \path[draw=wiAmber,fill=wiCream,line width=1.15pt,rounded corners=5pt]%
    (24.50,4.08) rectangle (28.15,4.84);%
  \node[text=wiAmber,font=\rmfamily\bfseries\fontsize{16}{17}\selectfont]%
    at (24.94,4.46) {?};%
  \node[wi label,text=wiAmber,font=\rmfamily\bfseries\fontsize{14}{16}\selectfont]%
    at (26.58,4.46) {Unresolved};%
  % Shared evidence: a single database and reuse symbol.
  \pic[scale=0.52] at (6.10,2.77) {wi database};%
  \pic[scale=0.50] at (6.65,2.20) {wi reuse};%
  \node[wi label,font=\rmfamily\bfseries\fontsize{12.5}{14.5}\selectfont]%
    at (8.80,3.28) {Shared evidence};%
  \node[wi small,font=\rmfamily\fontsize{11.5}{13}\selectfont]%
    at (8.80,2.51) {Retained + new\\reports};%
  \node[wi small,font=\rmfamily\fontsize{11.5}{13}\selectfont]%
    at (7.925,1.75) {Model-validity interval};%
  % Acquisition choices and resource limits, with no miniature subdiagrams.
  \node[wi label] at (16.925,3.36) {Directional acquisition};%
  \foreach \x/\labeltext in {13.90/Aggregate,16.925/Radio,19.95/Server}{%
    \path[draw=wiBorder,fill=white,line width=0.9pt,rounded corners=4pt]%
      (\x-1.27,2.22) rectangle (\x+1.27,2.94);%
    \node[wi label,font=\rmfamily\bfseries\fontsize{12}{14}\selectfont]%
      at (\x,2.58) {\labeltext};%
  }%
  \node[wi small] at (16.925,1.79) {Time\,$\cdot$\, Cost\,$\cdot$\, Count limits};%
  % Physical system: one radio, one server, and their connection.
  \draw[draw=wiTeal,line width=1.45pt,rounded corners=4pt]%
    (24.55,2.65)--(25.04,2.65)--(25.04,2.93)--(25.60,2.93);%
  \pic[scale=0.67] at (24.10,2.76) {wi radio};%
  \pic[scale=1.02] at (26.12,2.76) {wi server};%
  \node[wi label,font=\rmfamily\bfseries\fontsize{14}{16}\selectfont] at (25.23,1.66) {Wireless--edge system};%
\end{tikzpicture}%
\endgroup%
